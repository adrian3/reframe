[Unit]
Description=Reframe Dashboard Service
# The dashboard should still come up if the camera service is waiting for
# hardware or crash-looping.
After=network.target
Wants=network.target
Wants=reframe.service

[Service]
Type=simple
User=cam
Group=cam
WorkingDirectory=/home/cam/reframe
ExecStart=/home/cam/reframe/scripts/reframe-python /home/cam/reframe/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardware access permissions (same as reframe service)
SupplementaryGroups=video i2c spi gpio

[Install]
WantedBy=multi-user.target
