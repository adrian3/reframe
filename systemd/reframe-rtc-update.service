[Unit]
Description=Update the PiSugar RTC after network time synchronization
Wants=pisugar-server.service systemd-timesyncd.service reframe-rtc-restore.service
After=pisugar-server.service network.target systemd-timesyncd.service reframe-rtc-restore.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/reframe-rtc-sync update
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
