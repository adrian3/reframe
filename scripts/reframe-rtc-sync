#!/bin/bash
set -u

PISUGAR_SOCKET="${PISUGAR_SOCKET:-/tmp/pisugar-server.sock}"
LAST_NETWORK_SYNC_PATH="${LAST_NETWORK_SYNC_PATH:-/var/lib/reframe/rtc-last-network-sync}"
MIN_VALID_RTC_EPOCH="1704067200" # 2024-01-01T00:00:00Z
MAX_VALID_RTC_EPOCH="4102444800" # 2100-01-01T00:00:00Z
MAX_RTC_ADVANCE_SECONDS="158112000" # Five years beyond the last trusted sync

pisugar_command() {
    printf '%s\n' "$1" | nc -U -w 2 -q 0 "$PISUGAR_SOCKET"
}

require_utc() {
    local timezone
    timezone="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
    if [ "$timezone" != "UTC" ] && [ "$timezone" != "Etc/UTC" ]; then
        echo "PiSugar RTC sync skipped: system timezone must be UTC (found ${timezone:-unknown})" >&2
        return 1
    fi
}

wait_for_pisugar() {
    local attempt
    for attempt in 1 2 3 4 5 6 7 8; do
        if pisugar_command "get model" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done

    echo "PiSugar RTC sync skipped: pisugar-server did not become ready" >&2
    return 1
}

restore_from_rtc() {
    local rtc_response rtc_time rtc_epoch last_sync_epoch response

    require_utc || return 0
    wait_for_pisugar || return 0
    rtc_response="$(pisugar_command "get rtc_time" 2>/dev/null || true)"
    rtc_time="${rtc_response#*:}"
    rtc_time="${rtc_time# }"
    rtc_epoch="$(date --date="$rtc_time" +%s 2>/dev/null || true)"

    if [ -z "$rtc_epoch" ] \
        || [ "$rtc_epoch" -lt "$MIN_VALID_RTC_EPOCH" ] \
        || [ "$rtc_epoch" -ge "$MAX_VALID_RTC_EPOCH" ]; then
        echo "PiSugar RTC sync skipped: RTC time is missing or uninitialized" >&2
        return 0
    fi

    if [ -r "$LAST_NETWORK_SYNC_PATH" ]; then
        last_sync_epoch="$(head -n 1 "$LAST_NETWORK_SYNC_PATH" 2>/dev/null || true)"
        if [[ "$last_sync_epoch" =~ ^[0-9]+$ ]]; then
            if [ "$rtc_epoch" -lt $((last_sync_epoch - 300)) ]; then
                echo "PiSugar RTC sync skipped: RTC predates the last trusted network sync" >&2
                return 0
            fi
            if [ "$rtc_epoch" -gt $((last_sync_epoch + MAX_RTC_ADVANCE_SECONDS)) ]; then
                echo "PiSugar RTC sync skipped: RTC is implausibly far beyond the last trusted network sync" >&2
                return 0
            fi
        fi
    fi

    response="$(pisugar_command "rtc_rtc2pi" 2>/dev/null || true)"
    if [[ "$response" != *"done"* && "$response" != *"Done"* ]]; then
        echo "PiSugar RTC-to-Pi sync failed: ${response:-no response}" >&2
        return 1
    fi

    echo "Restored system time from the PiSugar RTC"
}

update_rtc_after_network_sync() {
    local attempt response network_epoch marker_tmp

    require_utc || return 0
    wait_for_pisugar || return 0

    # The camera shuts down after ten idle minutes, so wait within that same
    # window for systemd-timesyncd to obtain authoritative network time.
    for attempt in $(seq 1 120); do
        if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ]; then
            response="$(pisugar_command "rtc_pi2rtc" 2>/dev/null || true)"
            if [[ "$response" != *"done"* && "$response" != *"Done"* ]]; then
                echo "Pi-to-PiSugar RTC sync failed: ${response:-no response}" >&2
                return 1
            fi

            network_epoch="$(date +%s)"
            marker_tmp="${LAST_NETWORK_SYNC_PATH}.tmp.$$"
            if install -d -m 0755 "$(dirname "$LAST_NETWORK_SYNC_PATH")" \
                && printf '%s\n' "$network_epoch" > "$marker_tmp" \
                && chmod 0644 "$marker_tmp" \
                && mv "$marker_tmp" "$LAST_NETWORK_SYNC_PATH"; then
                :
            else
                echo "Warning: could not record the last trusted network sync" >&2
                rm -f "$marker_tmp"
            fi

            echo "Updated the PiSugar RTC from network-synchronized system time"
            return 0
        fi
        sleep 5
    done

    echo "PiSugar RTC update skipped: network time did not synchronize" >&2
}

case "${1:-}" in
    restore)
        restore_from_rtc
        ;;
    update)
        update_rtc_after_network_sync
        ;;
    *)
        echo "Usage: $0 {restore|update}" >&2
        exit 2
        ;;
esac
