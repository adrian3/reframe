#!/usr/bin/env python3
"""Wait until Picamera2 reports at least one camera."""

import argparse
import sys
import time

from picamera2 import Picamera2


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--timeout", type=float, default=60.0)
    parser.add_argument("--interval", type=float, default=1.0)
    args = parser.parse_args()

    deadline = time.monotonic() + args.timeout
    last_error = None

    while time.monotonic() < deadline:
        try:
            cameras = Picamera2.global_camera_info()
            if cameras:
                print(f"Camera detected: {cameras[0].get('Model', 'unknown')}", flush=True)
                return 0
            last_error = "no cameras reported"
        except Exception as exc:
            last_error = str(exc)
        time.sleep(args.interval)

    print(f"Timed out waiting for camera: {last_error}", file=sys.stderr, flush=True)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
