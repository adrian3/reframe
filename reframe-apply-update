#!/bin/bash
set -euo pipefail

REPO_PATH="/home/cam/reframe"
CAM_HOME="/home/cam"

if [ "$(id -u)" -ne 0 ]; then
    echo "reframe-apply-update must run as root" >&2
    exit 1
fi

for required in requirements.txt reframe.service reframe-dashboard.service reframe-dashboard-proxy.service reframe-apply-update enable_hdr.sh; do
    if [ ! -f "$REPO_PATH/$required" ]; then
        echo "Missing update file: $required" >&2
        exit 1
    fi
done

pip_flags=(--user)
if runuser -u cam -- env HOME="$CAM_HOME" /usr/bin/python3 -m pip install --help 2>/dev/null | grep -- "--break-system-packages" >/dev/null; then
    pip_flags+=(--break-system-packages)
fi

runuser -u cam -- env HOME="$CAM_HOME" /usr/bin/python3 -m pip install "${pip_flags[@]}" -r "$REPO_PATH/requirements.txt"

install -o root -g root -m 0755 "$REPO_PATH/reframe-apply-update" /usr/local/sbin/reframe-apply-update
install -o root -g root -m 0644 "$REPO_PATH/reframe.service" /etc/systemd/system/reframe.service
install -o root -g root -m 0644 "$REPO_PATH/reframe-dashboard.service" /etc/systemd/system/reframe-dashboard.service
install -o root -g root -m 0644 "$REPO_PATH/reframe-dashboard-proxy.service" /etc/systemd/system/reframe-dashboard-proxy.service
chmod 0755 "$REPO_PATH/enable_hdr.sh"
systemctl daemon-reload

echo "Dependencies and service files updated; reboot to run the new code."
